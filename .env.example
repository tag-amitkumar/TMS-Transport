# Copy to .env and adjust. docker-compose reads this file automatically.

# "false" hides the login screen's quick-preview role chips and requires real
# credentials. Leave "true" only while this is a demo host — every seeded
# account shares the password printed in the public README.
TMS_DEMO_LOGIN=true

# Which seed profile the app generates if it ever has to seed from scratch.
# "minimal" is this branch's default; docker/entrypoint.sh normally copies the
# repo's committed CSVs instead, so this rarely comes into play.
TMS_SEED_PROFILE=minimal

# ------------------------------------------------------------------
# GitHub data sync — intentionally left unset here.
#
# R/github_sync.R pushes runtime CSVs back into the repo. That exists to work
# around shinyapps.io handing every instance an ephemeral filesystem, where
# unpushed data is simply lost. This deployment does not have that problem:
# data/ is a Docker volume that survives restarts, rebuilds and reboots.
#
# Turning sync on here would commit every booking, POD and GPS ping to a
# PUBLIC GitHub repo once a minute. Leave these blank unless you specifically
# want that. The module treats "unconfigured" as a supported state and stays
# completely inert — no writes, no errors.
#
# If you do want it, set the PAT yourself; never paste a token into a file
# that could be committed, and note .env is gitignored for exactly this reason.
#
# TMS_GITHUB_REPO_URL=https://github.com/tag-amitkumar/TMS-Transport.git
# TMS_GITHUB_PAT=
# TMS_GITHUB_BRANCH=minimal-setup
