# R
.Rproj.user
.Rhistory
.RData
.Ruserdata
*.Rproj

# Environment / secrets — never commit these
.Renviron
.env
rsconnect/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Runtime scratch
www/uploads/
*.log

# Screenshot tooling (see tools/capture-screenshots.js)
tools/node_modules/

# knitr intermediates — the rendered HANDBOOK.html is committed, its
# scratch dir is not
HANDBOOK_files/
HANDBOOK_cache/

# Deployment secrets — the tunnel credentials file authenticates as the tunnel
# itself, and config.yml embeds its UUID
cloudflared/*.json
cloudflared/config.yml
.env

# Credentials obtained through Meta Embedded Signup. Written outside the repo
# by default; this guards the case where someone points it inside.
wa_credentials.json
.tms/
